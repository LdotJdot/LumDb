<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/LdotJdot/LumDb.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<AssemblyVersion>3.0.1.0</AssemblyVersion>
	<FileVersion>3.0.1.0</FileVersion>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	<PackageIcon>DOGGEblack.png</PackageIcon>
	<PackageProjectUrl>https://github.com/LdotJdot/LumDb</PackageProjectUrl>
	<Copyright>MIT</Copyright>
	<Description>A single file database (Aot support)</Description>
	<PackageTags>database;single file;storage;aot;thread safe;source-generator</PackageTags>
	<PackageReleaseNotes>3.0.1: AddColumn/DropColumn and Vacuum. Page format stays 1.3.9. Commit still uses the page log; Vacuum swaps in a fully committed image.</PackageReleaseNotes>
	<Version>3.0.1</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
	    <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
    </PropertyGroup>
	
  <ItemGroup>
    <None Include="..\..\..\..\..\..\工作文件\XX集团\合同前项目准备\20230810 FLOW\DOGGEblack.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LumDbEngine.Generators\LumDbEngine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier" />
  </ItemGroup>

  <!-- Pack generator into NuGet analyzers folder -->
  <ItemGroup>
    <None Include="..\LumDbEngine.Generators\bin\$(Configuration)\netstandard2.0\LumDbEngine.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Condition="Exists('..\LumDbEngine.Generators\bin\$(Configuration)\netstandard2.0\LumDbEngine.Generators.dll')" Visible="false" />
  </ItemGroup>

</Project>
